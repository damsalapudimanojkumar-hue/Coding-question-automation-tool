# Copy this file to .env and fill in the values. .env is git-ignored (never committed).
# On Streamlit Cloud, set these same keys in the app's Secrets instead of a .env file.

# ── Required: the model provider ────────────────────────────────────────────
OPENROUTER_API_KEY=your-openrouter-key-here

# ── Optional: web research (Tavily). Without it, research falls back to open web ─
TAVILY_API_KEY=

# ── Optional: tracing/observability (Langfuse). Leave blank to disable ──────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ── Optional: durable question library on GitHub (tools/github_store.py) ────────
# Create a fine-grained token scoped to THIS repo with permission
#   Contents: Read and write   (nothing else needed).
# GH_BRANCH must already exist as an EMPTY branch and must NOT be the branch
# Streamlit deploys from, or every save would trigger a redeploy.
GITHUB_TOKEN=
GH_REPO=owner/repo
GH_BRANCH=question-bank
