        "code_details": [
          {
            "code_content": "import re\n\ndef build_term_frequency(corpus: list[str], stopwords: list[str]) -> dict[str, int]:\n    stopword_set = set(stopwords)\n    counts = {}\n    for doc in corpus:\n        lowered = doc.lower()\n        cleaned = re.sub(r'[^a-z ]', ' ', lowered)\n        tokens = cleaned.split()\n        for token in tokens:\n            if token and token not in stopword_set:\n                counts[token] = counts.get(token, 0) + 1\n    return dict(sorted(counts.items()))",
            "language": "PYTHON38_DATASCIENCE",
