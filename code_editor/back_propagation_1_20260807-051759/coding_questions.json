        "code_details": [
          {
            "code_content": "import numpy as np\n\ndef mse_output_gradient(y_true: list[float], y_pred: list[float]) -> list[float]:\n    y_true = np.array(y_true)\n    y_pred = np.array(y_pred)\n    grad = 2.0 * (y_pred - y_true)\n    return [round(float(g), 4) for g in grad]",
