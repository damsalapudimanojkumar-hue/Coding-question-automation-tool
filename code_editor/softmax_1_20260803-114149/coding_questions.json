        "code_details": [
          {
            "code_content": "import numpy as np\n\ndef stable_softmax(logits: list[list[float]]) -> list[list[float]]:\n    x = np.array(logits, dtype=float)\n    x_max = np.max(x, axis=-1, keepdims=True)\n    shifted = x - x_max\n    exp_shifted = np.exp(shifted)\n    result = exp_shifted / np.sum(exp_shifted, axis=-1, keepdims=True)\n    return np.round(result, 4).tolist()",
            "language": "PYTHON38_DATASCIENCE",
            "default_code": true,
