  "starter_code": "import pandas as pd\r\n\r\ndef daily_removal_ratio(user_actions, post_removals):\r\n    \"\"\"\r\n    Calculate the daily post removal ratio: posts removed on a day\r\n    divided by unique posts reported on that day.\r\n    \"\"\"\r\n    # Your code here\r\n    return",
  "solution_code": "import pandas as pd\ndef daily_removal_ratio(user_actions, post_removals):\n    ua = user_actions.copy(); ua[\"date\"] = pd.to_datetime(ua[\"date\"])\n    pr = post_removals.copy(); pr[\"removal_date\"] = pd.to_datetime(pr[\"removal_date\"])\n    reports = ua[ua[\"action\"] == \"report\"]\n    rep = reports.groupby(\"date\")[\"post_id\"].nunique().reset_index(name=\"reported_posts\")\n    pairs = reports[[\"date\", \"post_id\"]].drop_duplicates()\n    merged = pairs.merge(pr, left_on=[\"date\", \"post_id\"], right_on=[\"removal_date\", \"post_id\"])\n    removed = merged.groupby(\"date\")[\"post_id\"].nunique().reset_index(name=\"removed_posts\")\n    res = rep.merge(removed, on=\"date\", how=\"left\")\n    res[\"removed_posts\"] = res[\"removed_posts\"].fillna(0).astype(int)\n    res[\"removal_ratio\"] = (res[\"removed_posts\"] / res[\"reported_posts\"]).round(2)\n    return res.sort_values(\"date\").reset_index(drop=True)",
