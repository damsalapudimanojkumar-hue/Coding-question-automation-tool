  "solution_code": "import pandas as pd\ndef avg_score_multi_member_projects(project_data):\n    counts = project_data.groupby(\"project_id\")[\"team_member_id\"].nunique()\n    keep = counts[counts > 1].index\n    sub = project_data[project_data[\"project_id\"].isin(keep)]\n    res = sub.groupby(\"project_id\")[\"score\"].mean().round(2).reset_index()\n    res.columns = [\"project_id\", \"average_score\"]\n    return res",
